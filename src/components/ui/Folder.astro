---
/** A desktop folder that opens on hover/focus: the front flap tips forward and a page slides out. */
interface Props { href: string; label: string; tone?: 'olive' | 'blue' | 'kraft' | 'ink'; page?: string; size?: 'md' | 'lg'; attrs?: Record<string, string> }
const { href, label, tone = 'olive', page, size = 'md', attrs = {} } = Astro.props;
---
<a class:list={['folder', `folder--${tone}`, `folder--${size}`]} href={href} {...attrs}>
  <span class="folder__art" aria-hidden="true">
    <span class="folder__back"></span>
    <span class="folder__page">{page}</span>
    <span class="folder__front"></span>
  </span>
  <span class="folder__label">{label}</span>
</a>

<style>
  .folder {
    --c: var(--olive); --c-back: #5e6646;
    display: inline-grid; justify-items: center; gap: 0.55rem;
    padding: 0.4rem 0.4rem 0.3rem; border-radius: var(--r-3);
    text-decoration: none; color: var(--ink);
    transition: transform var(--d-press) var(--ease-out);
  }
  .folder--blue { --c: #3f6d96; --c-back: #2c5274; }
  .folder--kraft { --c: #c9a15f; --c-back: #a9844a; }
  .folder--ink { --c: #46453f; --c-back: #2f2e2a; }
  .folder:active { transform: scale(0.96); }
  .folder__art { position: relative; width: 4.5rem; aspect-ratio: 1.22; perspective: 240px; }
  .folder--lg .folder__art { width: 5.75rem; }
  .folder__back {
    position: absolute; inset: 8% 0 0; border-radius: 4px 6px 5px 5px;
    background: var(--c-back);
  }
  .folder__back::before {
    content: ""; position: absolute; left: 0; top: -12%; width: 42%; height: 18%;
    background: var(--c-back); border-radius: 4px 6px 0 0;
  }
  .folder__page {
    position: absolute; left: 10%; right: 10%; top: 4%; bottom: 10%;
    background: var(--card); border-radius: 2px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.15);
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.06em; color: var(--ink-3);
    padding: 0.35rem 0.4rem;
    transform: translateY(14%);
    transition: transform var(--d-base) var(--ease-out);
  }
  .folder__page::after {
    content: ""; position: absolute; left: 0.4rem; right: 0.6rem; top: 1.25rem; height: 0.9rem;
    background: repeating-linear-gradient(to bottom, var(--linen) 0 1px, transparent 1px 4px);
  }
  .folder__front {
    position: absolute; inset: 26% 0 0; border-radius: 3px 3px 5px 5px;
    background: var(--c);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.22), 0 6px 12px -8px rgb(40 30 15 / 0.7);
    transform-origin: 50% 100%;
    transition: transform var(--d-base) var(--ease-out);
  }
  .folder__label { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.04em; }
  @media (hover: hover) and (pointer: fine) {
    .folder:hover .folder__front { transform: rotateX(-32deg); }
    .folder:hover .folder__page { transform: translateY(-22%); }
  }
  .folder:focus-visible .folder__front { transform: rotateX(-32deg); }
  .folder:focus-visible .folder__page { transform: translateY(-22%); }
</style>
