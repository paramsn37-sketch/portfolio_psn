  <path d="M15 14v30a6 6 0 0 1-12 0V9a7 7 0 0 1 14 0v34a3.5 3.5 0 0 1-7 0V15" stroke="#9a978f" stroke-width="2.4" stroke-linecap="round" />
  <path d="M15 14v30a6 6 0 0 1-12 0V9a7 7 0 0 1 14 0v34a3.5 3.5 0 0 1-7 0V15" stroke="#d9d6cd" stroke-width="1" stroke-linecap="round" transform="translate(-.6 -.4)" />
</svg>
<style>.clip { position: absolute; z-index: 4; filter: drop-shadow(1px 2px 1.5px rgb(40 30 15 / 0.35)); pointer-events: none; }</style>
