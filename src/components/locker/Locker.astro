---
/**
 * The locker. Locked until the visitor has picked up the key (chapter 04). With the key,
 * it flies over, the lock turns, the locker grows to fill the page on a dark backdrop and
 * the door swings open. Inside: pixel portrait poster with yellow hand lettering, books,
 * pens, tablet and earbuds, stickers on the door. The tag hanging from the top of the poster
 * pulls it down into an endless black grid where the battleship lives in 3D.
 *
 * Everything inside is drawn in a 480×900 design grid; `--u` is one design pixel, so the
 * whole locker scales smoothly from its small size on the page to full screen.
 */
import '@fontsource/caveat/latin-700.css';
import '@fontsource/patrick-hand/latin.css';
import { locker } from '@/data/site';
const { portrait, posterTag, script, about, hereTo, note, sticker, ship } = locker;

/** Break text into lines of about `n` characters for SVG <text>. */
const wrap = (t: string, n: number) =>
  t.split(' ').reduce<string[]>((lines, w) => {
    const last = lines[lines.length - 1];
    if (last && (last + ' ' + w).length <= n) lines[lines.length - 1] = last + ' ' + w;
    else lines.push(w);
    return lines;
  }, []);
const gold = '#e9cd8c';
---
<div class="lk" id="locker" data-locker>
  <div class="lk__copy" data-reveal>
    <p class="lk__kicker">Staff only</p>
    <h3 class="lk__title">The locker</h3>
    <p class="lk__lede" data-lk-locked-copy>This is where I keep the creative side of me. It's locked, and only the person with the key gets in.</p>
    <p class="lk__story" data-lk-story hidden>{note}</p>
  </div>

  <div class="lk__slot" data-lk-slot data-reveal>
    <div class="lk__unit" data-lk-unit>
      <div class="lk__cab">
        <!-- interior -->
        <div class="lk__in" data-lk-in inert>
          <svg class="lk__wall" viewBox="0 0 428 820" aria-hidden="true">
            <defs>
              <linearGradient id="lkWall" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#4b4e52" /><stop offset="0.55" stop-color="#3f4245" /><stop offset="1" stop-color="#35383b" />
              </linearGradient>
              <radialGradient id="lkVig" cx="0.45" cy="0.3" r="0.9">
                <stop offset="0.5" stop-color="#000" stop-opacity="0" /><stop offset="1" stop-color="#000" stop-opacity="0.45" />
              </radialGradient>
              <linearGradient id="lkCone" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#fff6d8" stop-opacity="0.22" /><stop offset="1" stop-color="#fff6d8" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="lkTab" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#2a2c30" /><stop offset="0.45" stop-color="#121315" /><stop offset="1" stop-color="#26282b" />
              </linearGradient>
              <linearGradient id="lkFloor" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#55595d" /><stop offset="1" stop-color="#6c7074" />
              </linearGradient>
              <filter id="lkBlur" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="14" /></filter>
              <filter id="lkGlow" x="-50%" y="-200%" width="200%" height="500%"><feGaussianBlur stdDeviation="5" /></filter>
              <filter id="lkSoft" x="-10%" y="-10%" width="120%" height="140%"><feDropShadow dx="1" dy="3" stdDeviation="2.5" flood-opacity="0.45" /></filter>
            </defs>
            <rect width="428" height="820" fill="url(#lkWall)" />
            <rect width="428" height="820" fill="url(#lkVig)" />
            <!-- depth: ceiling and side walls -->
            <path d="M0 0H428L412 14H16Z" fill="#2b2e31" />
            <path d="M0 0L16 14V752L0 820Z" fill="#45484c" />
            <path d="M428 0L412 14V752L428 820Z" fill="#2f3235" />
            <!-- light -->
            <g class="lk__lamp">
              <path class="lk__cone" d="M128 24H300L430 520H-2Z" fill="url(#lkCone)" filter="url(#lkBlur)" />
              <rect x="124" y="13" width="180" height="12" rx="6" fill="#fff8de" filter="url(#lkGlow)" />
              <rect x="128" y="15" width="172" height="8" rx="4" fill="#fffdf2" />
            </g>

            <!-- notes on the wall -->
            <g class="lk__chalk">
              <text x="40" y="552" fill={gold} font-family="Caveat, cursive" font-weight="700" font-size="26">About me..</text>
              <text font-family="'Patrick Hand', cursive" font-size="15.5" fill="#f4f1ea">
                {wrap(about, 25).map((l, i) => <tspan x="40" y={588 + i * 20}>{l}</tspan>)}
              </text>
              <text x="246" y="572" fill={gold} font-family="Caveat, cursive" font-weight="700" font-size="24">I'm here to:-</text>
              <path d="M370 548c14 8 14 26 2 38m0 0l-1-10m1 10l-10-3" fill="none" stroke={gold} stroke-width="2.2" stroke-linecap="round" />
              <text font-family="'Patrick Hand', cursive" font-size="15.5" fill="#f4f1ea">
                {wrap(hereTo, 22).map((l, i) => <tspan x="238" y={606 + i * 20}>{l}</tspan>)}
              </text>
              <path d="M196 700c4-14 0-28-12-38m0 0l2 11m-2-11l10 4" fill="none" stroke={gold} stroke-width="2.2" stroke-linecap="round" />
            </g>

            <!-- shelf floor -->
            <path d="M16 752H412L428 808H0Z" fill="url(#lkFloor)" />
            <rect x="0" y="806" width="428" height="14" fill="#7c8084" />
            <rect x="0" y="806" width="428" height="2" fill="#9a9ea2" />

            <!-- books -->
            <g filter="url(#lkSoft)">
              <rect x="10" y="732" width="184" height="40" rx="3" fill="#b8892c" />
              <rect x="10" y="732" width="184" height="6" rx="2" fill="#d2a648" />
              <rect x="16" y="740" width="170" height="24" fill="#efe6cf" />
              <path d="M18 746H184M18 752H184M18 758H184" stroke="#d6cbb0" stroke-width="1" />
              <rect x="10" y="764" width="184" height="8" fill="#8f6a1f" />
              <g transform="rotate(-2 110 700)">
                <rect x="22" y="686" width="168" height="46" rx="3" fill="#25304d" />
                <rect x="22" y="686" width="168" height="7" rx="2" fill="#34406a" />
                <rect x="28" y="696" width="156" height="26" fill="#ece3cb" />
                <path d="M30 703H182M30 709H182M30 715H182" stroke="#d1c6aa" stroke-width="1" />
                <rect x="22" y="722" width="168" height="10" fill="#1b2340" />
                <rect x="82" y="724" width="46" height="5" rx="1" fill="#b8892c" opacity="0.8" />
              </g>
            </g>
            <!-- tablet -->
            <g filter="url(#lkSoft)">
              <path d="M222 748Q222 742 228 742H402Q408 742 409 748L418 790Q419 798 411 798H232Q225 798 224 791Z" fill="url(#lkTab)" />
              <path d="M232 750H398L405 788H238Z" fill="#0c0d0f" />
              <path d="M300 750H360L330 788H268Z" fill="#fff" opacity="0.06" />
            </g>
            <!-- earbuds -->
            <g filter="url(#lkSoft)">
              <rect x="300" y="716" width="76" height="30" rx="15" fill="#f1f0ec" />
              <path d="M302 728H374" stroke="#cfcdc6" stroke-width="1.2" />
              <ellipse cx="324" cy="722" rx="16" ry="4" fill="#fff" opacity="0.8" />
              <rect x="336" y="732" width="4" height="5" rx="1" fill="#bdbab2" />
            </g>
            <path d="M376 738c18-6 30 4 24 14s-30 2-20-6c8-6 26 0 22 10" fill="none" stroke="#1d1e20" stroke-width="2.4" stroke-linecap="round" />
            <path d="M384 744c14-2 18 8 10 12" fill="none" stroke="#e8e6e0" stroke-width="2" stroke-linecap="round" />
            <!-- pens -->
            <g stroke-linecap="round">
              <path d="M84 806L188 778" stroke="#2f5fb5" stroke-width="7" />
              <path d="M84 806L100 802" stroke="#c9ccd1" stroke-width="7" />
              <path d="M196 800L226 744" stroke="#b6302a" stroke-width="10" />
              <path d="M222 751L228 740" stroke="#7e1d18" stroke-width="10" />
              <path d="M230 800L318 806" stroke="#2f8a52" stroke-width="6.5" />
              <path d="M300 805L318 806" stroke="#d6a43a" stroke-width="6.5" />
            </g>
          </svg>

          <!-- the poster (drops down when the tag is pulled) -->
          <div class="lk__poster" data-lk-poster>
            <svg viewBox="0 0 316 386" overflow="visible" aria-hidden="true">
              <defs>
                <linearGradient id="lkPaper" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#717478" /><stop offset="1" stop-color="#5c5f63" />
                </linearGradient>
              </defs>
              <rect width="316" height="386" fill="url(#lkPaper)" />
              <rect width="316" height="386" fill="none" stroke="#000" stroke-opacity="0.25" />
              <image href={portrait.src} x="18" y="52" width="280" height="334" preserveAspectRatio="xMidYMax meet" style="image-rendering: pixelated" />
              <g class="lk__doodle" fill="none" stroke={gold} stroke-width="2.4" stroke-linecap="round">
                <ellipse cx="166" cy="40" rx="50" ry="13" transform="rotate(-10 166 40)" />
                <path d="M30 76c18-4 36-6 54-10M36 84c14-3 28-5 42-7" />
                <path d="M30 138c22-4 44-6 66-8M38 146c16-2 32-4 48-5" />
              </g>
              <g fill={gold}>
                <path d="M124 40l3 7 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z" />
                <path d="M208 22l2.4 5.6 6 .6-4.5 4 1.3 6-5.2-3-5.2 3 1.3-6-4.5-4 6-.6z" />
              </g>
              <g fill={gold} font-family="Caveat, cursive" font-weight="700">
                <text x="26" y="64" font-size="34" transform="rotate(-6 26 64)">{posterTag[0]}</text>
                <text x="26" y="126" font-size="34" transform="rotate(-5 26 126)">{posterTag[1]}</text>
              </g>
              <!-- masking tape -->
              <g fill="#cfc6b0" fill-opacity="0.62">
                <rect x="-18" y="-8" width="46" height="16" transform="rotate(-38 5 0)" />
                <rect x="288" y="-8" width="46" height="16" transform="rotate(38 311 0)" />
                <rect x="-18" y="378" width="46" height="16" transform="rotate(38 5 386)" />
                <rect x="288" y="378" width="46" height="16" transform="rotate(-38 311 386)" />
              </g>
            </svg>
            <button class="lk__tag" type="button" data-lk-pull aria-label="Pull the tag to take the poster down and see the battleship">
              <span class="lk__string" aria-hidden="true"></span>
              <span class="lk__tagcard"><span class="lk__hole" aria-hidden="true"></span>PULL<span aria-hidden="true">↓</span></span>
            </button>
          </div>

          <!-- big script lettering, written over the poster's bottom edge -->
          <svg class="lk__ink" viewBox="0 0 428 820" aria-hidden="true">
            <g fill={gold} font-family="Caveat, cursive" font-weight="700">
              <text x="52" y="436" font-size="62" transform="rotate(-3 52 436)">{script[0]}</text>
              <text x="150" y="488" font-size="54" transform="rotate(-3 150 488)">{script[1]}</text>
            </g>
          </svg>
          <span class="visually-hidden">{posterTag.join(' ')}. {script.join(' ')}. About me: {about} I'm here to {hereTo}</span>
        </div>

        <!-- frame details -->
        <span class="lk__latch" aria-hidden="true"></span>
        <span class="lk__hinge lk__hinge--a" aria-hidden="true"></span>
        <span class="lk__hinge lk__hinge--b" aria-hidden="true"></span>

        <!-- door -->
        <div class="lk__door" data-lk-door>
          <button class="lk__front" type="button" data-lk-lock aria-label="Locked locker. Open it with the key." aria-describedby="lk-hint">
            <span class="lk__plate" aria-hidden="true">P · S · N</span>
            <span class="lk__vents" aria-hidden="true">{Array.from({ length: 5 }, () => <i></i>)}</span>
            <span class="lk__handle" aria-hidden="true">
              <span class="lk__lock" data-lk-padlock>
                <span class="lk__shackle"></span>
                <span class="lk__lbody"><span class="lk__keyhole"></span></span>
              </span>
            </span>
            <span class="lk__vents lk__vents--low" aria-hidden="true">{Array.from({ length: 5 }, () => <i></i>)}</span>
            <span class="lk__num" aria-hidden="true">05</span>
          </button>
          <div class="lk__back" aria-hidden="true">
            <svg viewBox="0 0 440 832">
              <defs>
                <linearGradient id="lkDoor" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0" stop-color="#666a6e" /><stop offset="0.5" stop-color="#7a7e82" /><stop offset="1" stop-color="#6e7276" />
                </linearGradient>
                <linearGradient id="lkLouvre" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#9a9ea2" /><stop offset="0.5" stop-color="#868a8e" /><stop offset="1" stop-color="#5e6266" />
                </linearGradient>
                <filter id="lkStick" x="-20%" y="-20%" width="140%" height="150%"><feDropShadow dx="2" dy="4" stdDeviation="3" flood-opacity="0.45" /></filter>
              </defs>
              <rect width="440" height="832" rx="6" fill="url(#lkDoor)" />
              <rect x="14" y="14" width="412" height="804" rx="4" fill="none" stroke="#585c60" stroke-width="5" />
              <rect x="19" y="19" width="402" height="794" rx="3" fill="none" stroke="#8e9296" stroke-width="1.5" />
              <!-- hook + latch -->
              <path d="M398 232v22a10 10 0 0 1-20 0" fill="none" stroke="#c7cbcf" stroke-width="5" stroke-linecap="round" />
              <g transform="translate(386 400)">
                <rect x="-10" y="0" width="30" height="74" rx="4" fill="#2b2d30" />
                <rect x="-4" y="22" width="18" height="30" rx="9" fill="#55595d" />
                <rect x="2" y="30" width="6" height="14" rx="2" fill="#1a1b1d" />
              </g>
              <!-- logo sticker -->
              <g filter="url(#lkStick)" transform="rotate(-3 270 175)">
                <rect x="150" y="118" width="240" height="118" rx="18" fill="#fbfaf7" />
                <text x="270" y="200" text-anchor="middle" font-family="'Big Shoulders Display', sans-serif" font-weight="900" font-size="86" fill="#141414" stroke="#fbfaf7" stroke-width="3" paint-order="stroke" letter-spacing="2">{sticker.big}</text>
                <text x="270" y="222" text-anchor="middle" font-family="'Martian Mono', monospace" font-size="9.5" fill="#141414" letter-spacing="1.2">{sticker.small.toUpperCase()}</text>
                <path d="M168 132c10-8 26-6 30 6s-10 18-18 12" fill="none" stroke="#141414" stroke-width="5" stroke-linecap="round" />
              </g>
              <!-- Ps / Ai tiles -->
              <g filter="url(#lkStick)">
                <g transform="rotate(-2 186 314)">
                  <rect x="140" y="268" width="92" height="92" rx="14" fill="#f4f2ee" />
                  <rect x="147" y="275" width="78" height="78" rx="10" fill="#001e36" />
                  <text x="186" y="327" text-anchor="middle" font-family="'Hanken Grotesk Variable', sans-serif" font-weight="700" font-size="34" fill="#31a8ff">Ps</text>
                </g>
                <g transform="rotate(3 304 318)">
                  <rect x="258" y="272" width="92" height="92" rx="14" fill="#f4f2ee" />
                  <rect x="265" y="279" width="78" height="78" rx="10" fill="#330000" />
                  <text x="304" y="331" text-anchor="middle" font-family="'Hanken Grotesk Variable', sans-serif" font-weight="700" font-size="34" fill="#ff9a00">Ai</text>
                </g>
              </g>
              <!-- Figma-style sticker -->
              <g filter="url(#lkStick)" transform="rotate(-6 190 440)">
                <rect x="150" y="384" width="80" height="112" rx="22" fill="#f4f2ee" />
                <path d="M172 400h18v20h-18a10 10 0 0 1 0-20z" fill="#f24e1e" />
                <path d="M190 400h18a10 10 0 0 1 0 20h-18z" fill="#ff7262" />
                <path d="M172 420h18v20h-18a10 10 0 0 1 0-20z" fill="#a259ff" />
                <circle cx="208" cy="430" r="10" fill="#1abcfe" />
                <path d="M172 440h18v10a10 10 0 1 1-18-10z" fill="#0acf83" />
              </g>
              <!-- palette sticker -->
              <g filter="url(#lkStick)" transform="rotate(5 300 500)">
                <rect x="252" y="462" width="104" height="74" rx="6" fill="#f4f2ee" />
                {['#c0392b', '#e9b949', '#3f8f4f', '#7a4fb0', '#d9482b', '#2f6cc0'].map((c, i) => (
                  <rect x={262 + (i % 3) * 30} y={472 + Math.floor(i / 3) * 28} width="24" height="22" rx="2" fill={c} />
                ))}
              </g>
              <!-- louvres -->
              {[0, 1, 2, 3, 4].map((i) => (
                <g>
                  <rect x="176" y={592 + i * 46} width="172" height="26" rx="13" fill="#4e5256" />
                  <rect x="176" y={590 + i * 46} width="172" height="24" rx="12" fill="url(#lkLouvre)" />
                </g>
              ))}
            </svg>
          </div>
        </div>
      </div>
      <span class="lk__feet" aria-hidden="true"></span>
      <p class="lk__hint" id="lk-hint" data-lk-hint role="status" aria-live="polite"></p>
    </div>
  </div>
</div>

<!-- full-page backdrop while the locker is open -->
<div class="lk-stage" data-lk-stage hidden>
  <button class="lk-stage__close" type="button" data-lk-close>Close locker <span aria-hidden="true">✕</span></button>
</div>

<!-- the void -->
<div class="void" data-void hidden role="dialog" aria-modal="true" aria-labelledby="void-title" data-model={ship.model ?? ''}>
  <div class="void__grid" aria-hidden="true"></div>
  <canvas class="void__canvas" data-void-canvas aria-label="3D model of the battleship. Drag to rotate, scroll or pinch to zoom."></canvas>
  <div class="void__hud">
    <div class="void__meta">
      <p class="void__kicker">Behind the poster</p>
      <h2 class="void__title" id="void-title">{ship.title}</h2>
      <ul class="void__facts" role="list">{ship.facts.map((f) => <li>{f}</li>)}</ul>
      {!ship.model && <p class="void__tag">Stand-in model. The real scan is coming soon.</p>}
    </div>
    <button class="void__exit" type="button" data-void-exit>Exit <kbd>Esc</kbd></button>
  </div>
  <p class="void__help" data-void-help>Drag to rotate · scroll or pinch to zoom</p>
  <p class="void__loading" data-void-loading>loading the ship…</p>
</div>

<script>
  import { has, fly } from '@/scripts/inventory';

  const root = document.querySelector<HTMLElement>('[data-locker]');
  if (root) {
    const unit = root.querySelector<HTMLElement>('[data-lk-unit]')!;
    const slot = root.querySelector<HTMLElement>('[data-lk-slot]')!;
    const lockBtn = root.querySelector<HTMLButtonElement>('[data-lk-lock]')!;
    const door = root.querySelector<HTMLElement>('[data-lk-door]')!;
    const padlock = root.querySelector<HTMLElement>('[data-lk-padlock]')!;
    const hint = root.querySelector<HTMLElement>('[data-lk-hint]')!;
    const inside = root.querySelector<HTMLElement>('[data-lk-in]')!;
    const story = root.querySelector<HTMLElement>('[data-lk-story]')!;
    const lockedCopy = root.querySelector<HTMLElement>('[data-lk-locked-copy]')!;
    const poster = root.querySelector<HTMLElement>('[data-lk-poster]')!;
    const pull = root.querySelector<HTMLButtonElement>('[data-lk-pull]')!;
    const stage = document.querySelector<HTMLElement>('[data-lk-stage]')!;
    const closeBtn = stage.querySelector<HTMLButtonElement>('[data-lk-close]')!;
    const voidEl = document.querySelector<HTMLElement>('[data-void]')!;
    document.body.append(stage, voidEl);
    const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, reduce() ? 0 : ms));

    /* ---------- locked ---------- */
    const misses = [
      "Psst. You haven't found the key yet. Did you miss it? ;)",
      'Still locked. I keep spare keys where I keep my tools…',
      'Hint: chapter 04, hanging on a nail. Go on, I’ll wait. :)',
    ];
    let tries = 0;
    let hintTimer = 0;
    const say = (msg: string) => {
      hint.textContent = msg;
      hint.classList.add('is-on');
      clearTimeout(hintTimer);
      hintTimer = window.setTimeout(() => hint.classList.remove('is-on'), 3800);
    };

    /* ---------- grow to fill the page ---------- */
    // the open door sticks out to the right of the cabinet by about this much of its width
    const DOOR = 0.62;
    const RATIO = 912 / 480;
    const fit = () => {
      const pad = innerWidth < 640 ? 12 : 28;
      const top = innerWidth < 640 ? 64 : 72;
      const aw = innerWidth - pad * 2;
      const ah = innerHeight - top - pad;
      const narrow = innerWidth < innerHeight;
      // on tall phones let the door run off the right edge so the inside stays readable
      const w = Math.min(narrow ? aw * 0.84 : aw / (1 + DOOR), ah / RATIO);
      const total = narrow ? w : w * (1 + DOOR);
      return { left: Math.max(pad, (innerWidth - total) / 2), top: top + (ah - w * RATIO) / 2, width: w };
    };
    const place = (r: { left: number; top: number; width: number }) => {
      unit.style.left = `${r.left}px`;
      unit.style.top = `${r.top}px`;
      unit.style.width = `${r.width}px`;
    };

    let big = false;
    let busy = false;
    const expand = async () => {
      const r = unit.getBoundingClientRect();
      slot.style.height = `${slot.offsetHeight}px`;
      unit.classList.add('is-big');
      unit.style.transition = 'none';
      place(r);
      document.body.append(unit);
      stage.hidden = false;
      document.documentElement.classList.add('void-lock');
      void unit.offsetWidth;
      stage.classList.add('is-on');
      unit.style.transition = '';
      place(fit());
      big = true;
      await wait(800);
    };

    const openDoor = () => {
      unit.classList.add('is-open');
      inside.inert = false;
      story.hidden = false;
      lockedCopy.textContent = 'You found the key. Welcome in. Mind the glue.';
      lockBtn.setAttribute('aria-label', 'Close the locker door');
      hint.classList.remove('is-on');
      setTimeout(() => pull.focus({ preventScroll: true }), reduce() ? 0 : 1000);
    };

    const collapse = async () => {
      if (!big || busy) return;
      busy = true;
      unit.classList.remove('is-open');
      inside.inert = true;
      lockBtn.setAttribute('aria-label', 'Open the locker');
      await wait(700);
      stage.classList.remove('is-on');
      const s = slot.getBoundingClientRect();
      place({ left: s.left + (s.width - slot.offsetWidth) / 2, top: s.top, width: slot.offsetWidth });
      await wait(750);
      unit.classList.remove('is-big');
      unit.removeAttribute('style');
      slot.append(unit);
      slot.style.height = '';
      stage.hidden = true;
      document.documentElement.classList.remove('void-lock');
      big = false;
      busy = false;
      lockBtn.focus({ preventScroll: true });
    };

    addEventListener('resize', () => { if (big) { unit.style.transition = 'none'; place(fit()); void unit.offsetWidth; unit.style.transition = ''; } });

    lockBtn.addEventListener('click', async () => {
      if (busy) return;
      if (big) return; // door is open; the close button handles leaving
      if (!has('key')) {
        padlock.classList.remove('is-shake'); void padlock.offsetWidth; padlock.classList.add('is-shake');
        door.classList.remove('is-rattle'); void door.offsetWidth; door.classList.add('is-rattle');
        say(misses[Math.min(tries++, misses.length - 1)]);
        return;
      }
      busy = true;
      if (!unit.classList.contains('was-unlocked')) {
        const sackBtn = document.querySelector<HTMLElement>('[data-sack-btn]');
        const keyArt = document.querySelector<SVGElement>('[data-sack-key] svg') ?? document.querySelector<SVGElement>('[data-key-art]');
        if (sackBtn && keyArt) {
          const s = sackBtn.getBoundingClientRect();
          const from = new DOMRect(s.left - 10, s.top + s.height / 2 - 12, 64, 24);
          const kh = padlock.getBoundingClientRect();
          const to = new DOMRect(kh.left + kh.width / 2 - 20, kh.top + kh.height * 0.62 - 7, 40, 15);
          await fly(keyArt, from, to, 900);
        }
        padlock.classList.add('is-unlocking');
        unit.classList.add('was-unlocked');
        await wait(650);
      }
      await expand();
      openDoor();
      busy = false;
    });
    closeBtn.addEventListener('click', collapse);

    /* ---------- pull the tag → the void ---------- */
    let ship: { dispose(): void } | null = null;
    const exitBtn = voidEl.querySelector<HTMLButtonElement>('[data-void-exit]')!;

    const openVoid = async () => {
      if (!voidEl.hidden) return;
      unit.classList.add('is-pulled');
      poster.style.transform = '';
      await wait(550);
      const r = poster.getBoundingClientRect();
      voidEl.style.setProperty('--x', `${Math.max(0, r.left)}px`);
      voidEl.style.setProperty('--y', `${Math.max(0, r.top)}px`);
      voidEl.style.setProperty('--r', `${Math.max(0, innerWidth - r.right)}px`);
      voidEl.style.setProperty('--b', `${Math.max(0, innerHeight - r.bottom)}px`);
      voidEl.hidden = false;
      void voidEl.offsetWidth;
      voidEl.classList.add('is-open');
      exitBtn.focus({ preventScroll: true });
      try {
        const { mountShip } = await import('@/scripts/ship');
        ship = await mountShip(voidEl.querySelector('canvas')!, voidEl.dataset.model || undefined);
      } catch (e) {
        console.error(e);
        voidEl.querySelector('[data-void-help]')!.textContent = 'The 3D view could not start in this browser.';
      }
      voidEl.querySelector('[data-void-loading]')?.setAttribute('hidden', '');
    };

    const closeVoid = () => {
      if (voidEl.hidden) return;
      voidEl.classList.remove('is-open');
      const done = () => {
        voidEl.hidden = true;
        ship?.dispose(); ship = null;
        voidEl.querySelector('[data-void-loading]')?.removeAttribute('hidden');
        unit.classList.remove('is-pulled');
        pull.focus({ preventScroll: true });
      };
      reduce() ? done() : setTimeout(done, 450);
    };

    // the tag can be clicked, or dragged down like a real pull-down poster
    let dragY: number | null = null;
    let moved = false;
    pull.addEventListener('pointerdown', (e) => {
      dragY = e.clientY; moved = false;
      pull.setPointerCapture(e.pointerId);
      poster.style.transition = 'none';
    });
    pull.addEventListener('pointermove', (e) => {
      if (dragY === null) return;
      const dy = Math.max(0, e.clientY - dragY);
      if (dy > 4) moved = true;
      poster.style.transform = `translateY(${Math.min(dy, 160)}px)`;
    });
    const release = (e: PointerEvent) => {
      if (dragY === null) return;
      const dy = e.clientY - dragY;
      dragY = null;
      poster.style.transition = '';
      if (moved && dy < 40) { poster.style.transform = ''; return; }
      if (moved) openVoid();
    };
    pull.addEventListener('pointerup', release);
    pull.addEventListener('pointercancel', () => { dragY = null; poster.style.transition = ''; poster.style.transform = ''; });
    pull.addEventListener('click', () => { if (!moved) openVoid(); moved = false; });
    exitBtn.addEventListener('click', closeVoid);

    document.addEventListener('keydown', (e) => {
      if (!voidEl.hidden) {
        if (e.key === 'Escape') closeVoid();
        if (e.key === 'Tab') { e.preventDefault(); exitBtn.focus(); }
        return;
      }
      if (big) {
        if (e.key === 'Escape') collapse();
        if (e.key === 'Tab') {
          e.preventDefault();
          (document.activeElement === pull ? closeBtn : pull).focus();
        }
      }
    });
  }
</script>

