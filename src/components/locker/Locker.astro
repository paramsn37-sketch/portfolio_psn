  .lkp__string { width: calc(2.25 * var(--u)); height: calc(45 * var(--u)); background: #e9e2cf; }
  .lkp__card {
    position: relative; display: grid; justify-items: center; gap: calc(1.5 * var(--u)); padding: calc(21 * var(--u)) calc(12 * var(--u)) calc(10.5 * var(--u)); margin-top: calc(-1.5 * var(--u));
    background: #c8a979; color: #2b2112; font: 700 calc(15 * var(--u))/1 var(--font-mono); letter-spacing: 0.12em;
    clip-path: polygon(50% 0, 100% calc(15 * var(--u)), 100% 100%, 0 100%, 0 calc(15 * var(--u)));
  }
