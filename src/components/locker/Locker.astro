    35% { opacity: 0.3; } 36% { opacity: 0.95; } 38% { opacity: 0; } 60% { opacity: 0.1; } 68% { opacity: 0.45; } 71% { opacity: 0; } 87% { opacity: 0.05; } 88% { opacity: 0.75; } 89.5% { opacity: 0; }
