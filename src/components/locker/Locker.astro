---
/**
 * The locker.
 *
 * Closed: Param's row-of-lockers image. The middle locker (the one with stickers) is his,
 * because creativity is what makes him stand out. It's locked until the visitor has the key
 * from chapter 04. With the key: the key flies into the padlock, the lock drops, the view zooms into his locker,
 * the door swings open, and the inside (his reference image, cleaned up, with his own poster,
 * lettering and sticker) fades up on a dark full-page backdrop.
 *
 * Pulling the tag on the poster tears it in two; the hole behind glows, zooms and morphs into
 * the void, where the battleship lives.
 *
 * Closed, the row is five lockers wide (1646×1086); his is the middle one, padlocked, with warm
 * light flickering out of its louvres. Inside is laid out in the warm reference image's own
 * 1122×1402 pixel grid.
 */
import '@fontsource/caveat/latin-700.css';
import '@fontsource/patrick-hand/latin.css';
import '@fontsource/fraunces/latin-900.css';
import { locker } from '@/data/site';
const { front, inside, posterPaper, portrait, posterTag, script, explore, shipNote, note, sticker, ship } = locker;

/** Break text into lines of about `n` characters for SVG <text>. */
const wrap = (t: string, n: number) =>
  t.split(' ').reduce<string[]>((lines, w) => {
    const last = lines[lines.length - 1];
    if (last && (last + ' ' + w).length <= n) lines[lines.length - 1] = last + ' ' + w;
    else lines.push(w);
    return lines;
  }, []);
const gold = '#e7cd97';
// jagged tear line down the middle of the poster (x in %, y in %)
const tear = [52, 47, 55, 49, 46, 53, 50, 45, 54, 48, 51, 46, 55, 49];
const tearPts = tear.map((x, i) => `${x}% ${(i / (tear.length - 1)) * 100}%`);
// the left half reaches a hair past the tear so no seam shows while the poster is whole
const leftClip = `polygon(0 0, ${tear.map((x, i) => `${x + 0.9}% ${(i / (tear.length - 1)) * 100}%`).join(', ')}, 0 100%)`;
const rightClip = `polygon(100% 0, ${tearPts.join(', ')}, 100% 100%)`;
---
<div class="lk" id="locker" data-locker>
  <div class="lk__copy" data-reveal>
    <p class="lk__kicker">Staff only</p>
    <h3 class="lk__title">The locker</h3>
    <p class="lk__lede" data-lk-locked-copy>Every locker in the row looks the same, except mine. That's creativity. It's locked, and only the person with the key gets in.</p>
    <p class="lk__story" data-lk-story hidden>{note}</p>
  </div>

  <div class="lk__slot" data-lk-slot data-reveal>
    <div class="lkf" data-lk-front>
      <img class="lkf__img" src={front.src} alt={front.alt} width="1646" height="1086" loading="lazy" decoding="async" />
      <span class="lkf__dark" aria-hidden="true"></span>
      <button class="lkf__mine" type="button" data-lk-lock aria-label="Param's locker. It's locked; open it with the key." aria-describedby="lk-hint">
        <span class="lkf__door" style={`background-image:url(${front.door})`} aria-hidden="true"></span>
        <span class="lkf__light" aria-hidden="true"><span class="lkf__glow"></span><span class="lkf__dim"></span></span>
        <span class="lkf__lock" data-lk-padlock aria-hidden="true">
          <img class="lkf__shackle" src={front.shackle} alt="" />
          <img class="lkf__body" src={front.padlock} alt="" />
        </span>
      </button>
      <p class="lk__hint" id="lk-hint" data-lk-hint role="status" aria-live="polite"></p>
    </div>
  </div>
</div>

<!-- full-page backdrop while the locker is open -->
<div class="lk-stage" data-lk-stage hidden>
  <button class="lk-stage__close" type="button" data-lk-close>Close locker <span aria-hidden="true">✕</span></button>
</div>

<!-- the open locker -->
<div class="lki" data-lk-inside hidden>
  <div class="lki__scene" data-lk-scene>
    <img class="lki__base" src={inside} alt="" width="1122" height="1402" decoding="async" />
    <span class="lki__lamp" aria-hidden="true"></span>

    <!-- the black hole behind the poster, revealed when it tears -->
    <div class="lkp__hole" data-lk-hole aria-hidden="true"></div>

    <!-- the poster: two halves that tear apart -->
    {[leftClip, rightClip].map((clip, i) => (
      <div class:list={['lkp', i ? 'lkp--r' : 'lkp--l']} style={`--clip:${clip}`} aria-hidden={i ? 'true' : undefined}>
        <img class="lkp__paper" src={posterPaper} alt="" />
        <img class="lkp__face" src={portrait.src} alt={i ? '' : portrait.alt} width="46" height="55" />
        <svg class="lkp__ink" viewBox="0 0 433 534" aria-hidden="true"><g transform="scale(1.41)">
          <g fill="none" stroke={gold} stroke-width="2.2" stroke-linecap="round">
            <ellipse cx="168" cy="34" rx="56" ry="14" transform="rotate(-9 168 34)" />
            <path d="M18 66c16-5 32-7 46-9M24 74c12-3 24-4 34-5" />
            <path d="M14 136c18-4 36-6 54-7M22 144c13-2 26-3 38-3" />
          </g>
          <g fill={gold}>
            <path d="M122 32l2.6 6 6.4.7-4.8 4.3 1.4 6.3-5.6-3.3-5.6 3.3 1.4-6.3-4.8-4.3 6.4-.7z" />
            <path d="M210 18l2.2 5 5.4.6-4 3.6 1.2 5.3-4.8-2.8-4.8 2.8 1.2-5.3-4-3.6 5.4-.6z" />
          </g>
          <g fill={gold} font-family="Caveat, cursive" font-weight="700">
            <text x="10" y="54" font-size="34" transform="rotate(-8 10 54)">{posterTag[0]}</text>
            <text x="8" y="124" font-size="32" transform="rotate(-6 8 124)">{posterTag[1]}</text>
          </g>
        </g></svg>
      </div>
    ))}

    <!-- lettering and notes on the wall, sticker on the door, tape on the poster -->
    <svg class="lki__ink" viewBox="0 0 1122 1402" aria-hidden="true">
      <g fill={gold} font-family="Caveat, cursive" font-weight="700">
        <text x="168" y="738" font-size="84" transform="rotate(-4 168 738)">{script[0]}</text>
        <text x="322" y="798" font-size="72" transform="rotate(-3 322 798)">{script[1]}</text>
      </g>
      <g fill="#dcc49c" font-family="Caveat, cursive" font-weight="700">
        <text x="166" y="846" font-size="38">{explore.title}</text>
        <text x="462" y="850" font-size="36">{shipNote.title}</text>
      </g>
      <g font-family="'Patrick Hand', cursive" font-size="22" fill="#efe6d6">
        <text>{wrap(explore.text, 23).map((l, i) => <tspan x="156" y={892 + i * 30}>{l}</tspan>)}</text>
        <text>{wrap(shipNote.text, 24).map((l, i) => <tspan x="432" y={892 + i * 30}>{l}</tspan>)}</text>
      </g>
      <g fill="none" stroke="#dcc49c" stroke-width="2.6" stroke-linecap="round">
        <path d="M636 790c24 14 28 48 8 76m0 0l0-15m0 15l-14-5" />
        <path d="M352 1034c8-24 3-46-13-62m0 0l2 15m-2-15l14 5" />
      </g>
      <!-- my sticker where the reference's logo sticker was -->
      <g transform="translate(890 326) rotate(-9) skewY(-4)">
        <rect x="-106" y="-64" width="224" height="146" rx="34" fill="#000" fill-opacity="0.4" />
        <rect x="-112" y="-70" width="224" height="146" rx="34" fill="#ddd3c0" />
        <rect x="-105" y="-63" width="210" height="132" rx="28" fill="#141414" />
        <text x="0" y="26" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-weight="900" font-size="90" fill="#ddd3c0" letter-spacing="-1">{sticker.big}</text>
        <text x="0" y="55" text-anchor="middle" font-family="'Hanken Grotesk Variable', sans-serif" font-weight="700" font-size="13.5" fill="#ddd3c0" letter-spacing="1.2">{sticker.small.toUpperCase()}</text>
      </g>
    </svg>

    <button class="lkp__tag" type="button" data-lk-pull aria-label="Pull the tag to tear the poster down and explore the battleship">
      <span class="lkp__string" aria-hidden="true"></span>
      <span class="lkp__card"><span class="lkp__eye" aria-hidden="true"></span>PULL<span aria-hidden="true">↓</span></span>
    </button>
    <span class="lki__flash" aria-hidden="true"></span>
    <p class="visually-hidden">Poster: {posterTag.join(', ')}. {script.join(' ')}. {explore.title} {explore.text} {shipNote.title} {shipNote.text}</p>
  </div>
</div>

<!-- the void -->
<div class="void" data-void hidden role="dialog" aria-modal="true" aria-labelledby="void-title" data-model={ship.model ?? ''} data-spin={JSON.stringify(ship.spin)}>
  <div class="void__grid" aria-hidden="true"></div>
  <canvas class="void__canvas" data-void-canvas role="img" aria-label={ship.model ? '3D model of the battleship. Drag to rotate, scroll or pinch to zoom.' : `${ship.spin.alt}. Drag sideways or use the arrow keys to spin it, scroll to zoom.`}></canvas>
  <span class="void__glow" aria-hidden="true"></span>
  <div class="void__hud">
    <div class="void__meta">
      <p class="void__kicker">Behind the poster</p>
      <h2 class="void__title" id="void-title">{ship.title}</h2>
      <ul class="void__facts" role="list">{ship.facts.map((f) => <li>{f}</li>)}</ul>
    </div>
    <button class="void__exit" type="button" data-void-exit>Exit <kbd>Esc</kbd></button>
  </div>
  <p class="void__help" data-void-help>{ship.model ? 'Drag to rotate · scroll or pinch to zoom' : 'Drag to spin · scroll to zoom · ← → keys'}</p>
  <p class="void__loading" data-void-loading>loading…</p>
</div>

<script>
  import { has, fly } from '@/scripts/inventory';

  const root = document.querySelector<HTMLElement>('[data-locker]');
  if (root) {
    const slot = root.querySelector<HTMLElement>('[data-lk-slot]')!;
    const front = root.querySelector<HTMLElement>('[data-lk-front]')!;
    const lockBtn = root.querySelector<HTMLButtonElement>('[data-lk-lock]')!;
    const padlock = root.querySelector<HTMLElement>('[data-lk-padlock]')!;
    const hint = root.querySelector<HTMLElement>('[data-lk-hint]')!;
    const story = root.querySelector<HTMLElement>('[data-lk-story]')!;
    const lockedCopy = root.querySelector<HTMLElement>('[data-lk-locked-copy]')!;
    const stage = document.querySelector<HTMLElement>('[data-lk-stage]')!;
    const closeBtn = stage.querySelector<HTMLButtonElement>('[data-lk-close]')!;
    const insideEl = document.querySelector<HTMLElement>('[data-lk-inside]')!;
    const scene = insideEl.querySelector<HTMLElement>('[data-lk-scene]')!;
    const hole = insideEl.querySelector<HTMLElement>('[data-lk-hole]')!;
    const pull = insideEl.querySelector<HTMLButtonElement>('[data-lk-pull]')!;
    const voidEl = document.querySelector<HTMLElement>('[data-void]')!;
    document.body.append(stage, insideEl, voidEl);
    const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, reduce() ? 0 : ms));
    const html = document.documentElement;

    /* ---------- locked ---------- */
    const misses = [
      "Psst. You haven't found the key yet. Did you miss it? ;)",
      'Still locked. I keep spare keys where I keep my tools…',
      'Hint: chapter 04, hanging on a nail. Go on, I’ll wait. :)',
    ];
    let tries = 0;
    let hintTimer = 0;
    const say = (msg: string) => {
      hint.textContent = msg;
      hint.classList.add('is-on');
      clearTimeout(hintTimer);
      hintTimer = window.setTimeout(() => hint.classList.remove('is-on'), 3800);
    };
    const replay = (el: Element, cls: string) => { el.classList.remove(cls); void (el as HTMLElement).offsetWidth; el.classList.add(cls); };

    /* ---------- zoom into my locker, open it ---------- */
    const fitInside = () => {
      const top = innerWidth < 640 ? 60 : 64;
      const pad = innerWidth < 640 ? 10 : 24;
      const w = Math.min(innerWidth - pad * 2, (innerHeight - top - pad) * (1122 / 1402));
      insideEl.style.width = `${w}px`;
      insideEl.style.left = `${(innerWidth - w) / 2}px`;
      insideEl.style.top = `${top + (innerHeight - top - pad - w * (1402 / 1122)) / 2}px`;
    };

    let open = false;
    let busy = false;

    const zoomIn = async () => {
      const r = front.getBoundingClientRect();
      slot.style.height = `${slot.offsetHeight}px`;
      stage.hidden = false;
      html.classList.add('void-lock');
      document.body.append(front);
      front.classList.add('is-zoom');
      Object.assign(front.style, { left: `${r.left}px`, top: `${r.top}px`, width: `${r.width}px`, transition: 'none', transform: 'none' });
      void front.offsetWidth;
      stage.classList.add('is-on');
      const d = lockBtn.getBoundingClientRect();
      const s = (innerHeight * 1.04) / d.height;
      front.style.transformOrigin = `${d.left - r.left + d.width / 2}px ${d.top - r.top + d.height / 2}px`;
      front.style.transition = '';
      front.style.transform = `translate(${innerWidth / 2 - (d.left + d.width / 2)}px, ${innerHeight / 2 - (d.top + d.height / 2)}px) scale(${s})`;
      await wait(1050);
    };

    const openUp = async () => {
      front.classList.add('is-open');            // door swings
      await wait(450);
      fitInside();
      insideEl.hidden = false;
      void insideEl.offsetWidth;
      insideEl.classList.add('is-on');           // inside fades up as we step in
      front.classList.add('is-gone');
      await wait(900);
      open = true;
      story.hidden = false;
      lockedCopy.textContent = 'You found the key. Welcome in.';
      pull.focus({ preventScroll: true });
    };

    const close = async () => {
      if (!open || busy) return;
      busy = true;
      insideEl.classList.remove('is-on');
      front.classList.remove('is-gone');
      await wait(600);
      insideEl.hidden = true;
      front.classList.remove('is-open');
      await wait(650);
      stage.classList.remove('is-on');
      front.style.transform = 'none';
      await wait(900);
      front.classList.remove('is-zoom');
      front.removeAttribute('style');
      slot.append(front);
      slot.style.height = '';
      stage.hidden = true;
      html.classList.remove('void-lock');
      open = false;
      busy = false;
      lockBtn.focus({ preventScroll: true });
    };

    addEventListener('resize', () => { if (!insideEl.hidden) fitInside(); });

    lockBtn.addEventListener('click', async () => {
      if (busy || open) return;
      if (!has('key')) {
        replay(padlock, 'is-shake');
        replay(lockBtn, 'is-rattle');
        say(misses[Math.min(tries++, misses.length - 1)]);
        return;
      }
      busy = true;
      hint.classList.remove('is-on');
      if (!front.classList.contains('was-unlocked')) {
        const sackBtn = document.querySelector<HTMLElement>('[data-sack-btn]');
        const keyArt = document.querySelector<SVGElement>('[data-sack-key] svg') ?? document.querySelector<SVGElement>('[data-key-art]');
        if (sackBtn && keyArt) {
          const s = sackBtn.getBoundingClientRect();
          const k = padlock.getBoundingClientRect();
          // into the keyhole on the padlock's face
          await fly(keyArt, new DOMRect(s.left - 10, s.top + s.height / 2 - 12, 64, 24), new DOMRect(k.left + k.width * 0.64 - 16, k.top + k.height * 0.72 - 6, 32, 12), 900);
        }
        padlock.classList.add('is-unlocking');   // shackle pops up
        await wait(550);
        padlock.classList.add('is-dropped');      // and the lock falls away
        front.classList.add('was-unlocked');
        await wait(650);
      }
      await zoomIn();
      await openUp();
      busy = false;
    });
    closeBtn.addEventListener('click', close);

    /* ---------- pull the tag: tear, glow, zoom, morph into the void ---------- */
    let ship: { dispose(): void; nudge?(by: number): void } | null = null;
    const exitBtn = voidEl.querySelector<HTMLButtonElement>('[data-void-exit]')!;

    const toVoid = async () => {
      if (!voidEl.hidden || busy) return;
      busy = true;
      scene.classList.add('is-torn');            // halves rip apart and fall
      await wait(650);
      scene.classList.add('is-glow');            // the hole behind lights up
      const h = hole.getBoundingClientRect();
      scene.style.transformOrigin = `${((h.left + h.width / 2 - scene.getBoundingClientRect().left) / scene.offsetWidth) * 100}% ${((h.top + h.height / 2 - scene.getBoundingClientRect().top) / scene.offsetHeight) * 100}%`;
      scene.classList.add('is-dive');            // and we fall towards it
      await wait(500);
      const r = hole.getBoundingClientRect();
      voidEl.style.setProperty('--x', `${Math.max(0, r.left)}px`);
      voidEl.style.setProperty('--y', `${Math.max(0, r.top)}px`);
      voidEl.style.setProperty('--r', `${Math.max(0, innerWidth - r.right)}px`);
      voidEl.style.setProperty('--b', `${Math.max(0, innerHeight - r.bottom)}px`);
      voidEl.hidden = false;
      void voidEl.offsetWidth;
      voidEl.classList.add('is-open');
      exitBtn.focus({ preventScroll: true });
      busy = false;
      const canvas = voidEl.querySelector('canvas')!;
      const loading = voidEl.querySelector('[data-void-loading]');
      try {
        if (voidEl.dataset.model) {
          const { mountShip } = await import('@/scripts/ship');
          ship = await mountShip(canvas, voidEl.dataset.model);
        } else {
          const { mountSpin } = await import('@/scripts/turntable');
          ship = mountSpin(canvas, JSON.parse(voidEl.dataset.spin || '{}'), () => loading?.setAttribute('hidden', ''));
          return;
        }
      } catch (e) {
        console.error(e);
        voidEl.querySelector('[data-void-help]')!.textContent = 'The 3D view could not start in this browser.';
      }
      voidEl.querySelector('[data-void-loading]')?.setAttribute('hidden', '');
    };

    const closeVoid = () => {
      if (voidEl.hidden) return;
      voidEl.classList.remove('is-open');
      const done = () => {
        voidEl.hidden = true;
        ship?.dispose(); ship = null;
        voidEl.querySelector('[data-void-loading]')?.removeAttribute('hidden');
        scene.classList.remove('is-dive', 'is-glow', 'is-torn');
        pull.focus({ preventScroll: true });
      };
      reduce() ? done() : setTimeout(done, 500);
    };

    // click the tag, or drag it down
    let dragY: number | null = null;
    let moved = false;
    pull.addEventListener('pointerdown', (e) => { dragY = e.clientY; moved = false; pull.setPointerCapture(e.pointerId); });
    pull.addEventListener('pointermove', (e) => {
      if (dragY === null) return;
      const dy = Math.max(0, e.clientY - dragY);
      if (dy > 4) moved = true;
      pull.style.transform = `translateY(${Math.min(dy, 60)}px)`;
      scene.style.setProperty('--tug', `${Math.min(dy, 60) / 6}px`);
    });
    const release = (e: PointerEvent) => {
      if (dragY === null) return;
      const dy = e.clientY - dragY;
      dragY = null;
      pull.style.transform = '';
      scene.style.removeProperty('--tug');
      if (moved && dy >= 30) toVoid();
    };
    pull.addEventListener('pointerup', release);
    pull.addEventListener('pointercancel', () => { dragY = null; pull.style.transform = ''; scene.style.removeProperty('--tug'); });
    pull.addEventListener('click', () => { if (!moved) toVoid(); moved = false; });
    exitBtn.addEventListener('click', closeVoid);

    document.addEventListener('keydown', (e) => {
      if (!voidEl.hidden) {
        if (e.key === 'Escape') closeVoid();
        if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') { e.preventDefault(); ship?.nudge?.(e.key === 'ArrowLeft' ? -3 : 3); }
        if (e.key === 'Tab') { e.preventDefault(); exitBtn.focus(); }
        return;
      }
      if (open) {
        if (e.key === 'Escape') close();
        if (e.key === 'Tab') { e.preventDefault(); (document.activeElement === pull ? closeBtn : pull).focus(); }
      }
    });
  }
</script>

<style>
  .lk {
    display: grid; grid-template-columns: minmax(0, 22rem) minmax(0, 40rem); justify-content: center; gap: clamp(1.5rem, 6vw, 5rem);
    align-items: center; margin-block: clamp(3rem, 7vw, 5.5rem);
  }
  .lk__kicker { font-family: var(--font-mono); font-size: var(--t-meta); letter-spacing: 0.14em; text-transform: uppercase; color: var(--red-string); margin: 0 0 0.4rem; }
  .lk__title { font-family: var(--font-display); font-size: var(--t-h3); line-height: var(--lh-tight); text-transform: uppercase; margin: 0 0 0.8rem; }
  .lk__lede { color: var(--ink-2); max-width: 40ch; margin: 0; }
  .lk__story { margin: 1rem 0 0; max-width: 46ch; }

  /* ---------- closed: the row of five lockers (1646×1086); mine is x 681–983, y 52–1058 ---------- */
  .lk__slot { width: 100%; }
  .lkf {
    position: relative; width: 100%; aspect-ratio: 1646 / 1086; overflow: hidden; border-radius: 6px; perspective: 1600px;
    box-shadow: 0 24px 40px -22px rgb(0 0 0 / 0.65), 0 0 0 1px rgb(0 0 0 / 0.2);
  }
  .lkf__img { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; display: block; }
  /* the inside of the locker, seen as the door swings */
  .lkf__dark, .lkf__mine { position: absolute; left: calc(681 / 1646 * 100%); top: calc(52 / 1086 * 100%); width: calc(302 / 1646 * 100%); height: calc(1006 / 1086 * 100%); }
  .lkf__dark { background: radial-gradient(ellipse at 50% 12%, #8a6a45 0%, #2a2018 45%, #070707 100%); }
  .lkf__mine {
    all: unset; position: absolute; left: calc(681 / 1646 * 100%); top: calc(52 / 1086 * 100%); width: calc(302 / 1646 * 100%); height: calc(1006 / 1086 * 100%);
    cursor: pointer; transform-origin: right center; transition: transform 0.9s cubic-bezier(0.3, 0.1, 0.25, 1), filter 0.3s;
  }
  .lkf__door { position: absolute; inset: 0; background-size: 100% 100%; box-shadow: -10px 0 18px -6px rgb(0 0 0 / 0); transition: box-shadow 0.9s; }
  .lkf__mine:hover { filter: brightness(1.1); }
  .lkf__mine:focus-visible { outline: 3px solid var(--note); outline-offset: -3px; }
  .lkf.is-open .lkf__mine { transform: rotateY(-102deg); filter: none; }
  .lkf.is-open .lkf__door { box-shadow: -14px 0 24px -4px rgb(0 0 0 / 0.6); }
  .lkf__mine.is-rattle { animation: lk-rattle 0.35s ease; }
  @keyframes lk-rattle { 0%, 100% { translate: 0; } 25% { translate: -2px; } 75% { translate: 2px; } }

  /* warm light leaking out of the louvres (top ~12%, bottom ~85% of the door), flickering */
  .lkf__light { position: absolute; inset: 0; pointer-events: none; transition: opacity 0.4s; }
  .lkf__glow, .lkf__dim { position: absolute; inset: -4% -12%; }
  .lkf__glow {
    mix-blend-mode: screen; animation: lk-flicker 5.2s linear infinite;
    background:
      radial-gradient(ellipse 30% 6% at 50% 12%, rgb(255 190 110 / 0.5), transparent 70%),
      radial-gradient(ellipse 30% 5% at 50% 84%, rgb(255 190 110 / 0.42), transparent 70%),
      radial-gradient(ellipse 55% 26% at 50% 16%, rgb(255 170 90 / 0.2), transparent 70%),
      radial-gradient(ellipse 50% 14% at 50% 82%, rgb(255 170 90 / 0.14), transparent 70%);
  }
