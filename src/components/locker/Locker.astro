    .lkf__lock.is-shake, .lkf__mine.is-rattle, .lkp__tag, .lki.is-on .lki__flash, .lki__lamp, .lkf__glow, .lkf__dim { animation: none; }
    .lkf__lock, .lkf__shackle { transition: none; }
    .is-torn .lkp--l, .is-torn .lkp--r { animation: none; opacity: 0; }
  }

  /* ---------- the void: a dark exhibition hall with a spotlight on the ship ---------- */
  .void {
    --gold: #e9c27a; --ink: #f1ece1; --mute: #8f8a7e;
    position: fixed; inset: 0; z-index: 1100; background: #050505; color: var(--ink); overflow: hidden;
    clip-path: inset(var(--y, 40%) var(--r, 40%) var(--b, 40%) var(--x, 40%)); transition: clip-path 0.75s cubic-bezier(0.7, 0, 0.2, 1);
  }
  .void.is-open { clip-path: inset(0 0 0 0); }
  .void.is-closing { transition-duration: 0.7s; transition-timing-function: cubic-bezier(0.6, 0, 0.35, 1); }
  .void[hidden] { display: none; }
  .void__bg {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 34% 60% at 50% -8%, rgb(255 226 180 / 0.16), transparent 70%),
      radial-gradient(ellipse 46% 18% at 50% 64%, rgb(255 214 160 / 0.08), transparent 70%),
      radial-gradient(ellipse 120% 90% at 50% 40%, #16140f 0%, #0a0907 55%, #030303 100%);
  }
  /* perspective floor that fades into the dark */
  .void__floor { position: absolute; left: -30%; right: -30%; top: 57%; bottom: -10%; perspective: 520px; perspective-origin: 50% 0; mask-image: linear-gradient(#0000, #000 22%, #000 55%, #0000); }
  .void__floor-grid {
