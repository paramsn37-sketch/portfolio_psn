---
/**
 * An honest image slot. Shows the real image when `src` is set; otherwise a
 * labelled paper placeholder with an image icon, sized to its aspect ratio.
 */
import Icon from './Icon.astro';
interface Props { src?: string; alt: string; ratio?: string; label?: string; tone?: 'paper' | 'dark' | 'linen'; class?: string; eager?: boolean; icon?: string }
const { src, alt, ratio = '4 / 3', label, tone = 'paper', class: cls, eager = false, icon = 'image' } = Astro.props;
---
{src ? (
  <img class:list={['ph-img', cls]} src={src} alt={alt} style={`aspect-ratio:${ratio}`} loading={eager ? 'eager' : 'lazy'} decoding="async" />
) : (
  <div class:list={['ph', `ph--${tone}`, cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={`Placeholder: ${alt}`}>
    <Icon name={icon} size={26} stroke={1.3} />
    <span class="ph__label">{label ?? alt}</span>
    <span class="ph__hint">Replace me</span>
  </div>
)}

<style>
  .ph-img { width: 100%; object-fit: cover; display: block; }
  .ph {
    position: relative;
    width: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.4rem;
    padding: 0.75rem;
    text-align: center;
    color: var(--ink-2);
    background-color: var(--paper-2);
    overflow: hidden;
    container-type: inline-size;
  }
  /* an empty photo slot: dashed frame inset from the edge, like the corners of an album page */
  .ph::before {
    content: ""; position: absolute; inset: clamp(4px, 4%, 12px);
    border: 1px dashed var(--linen-2); border-radius: 1px;
    pointer-events: none;
  }
  .ph--linen { background-color: var(--linen); color: var(--ink-2); }
  .ph--linen::before { border-color: #b9ae96; }
  .ph--dark { background-color: #33302a; color: #b9b2a2; }
  .ph--dark::before { border-color: rgb(255 255 255 / 0.16); }
  .ph__label {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.04em; text-transform: uppercase;
    max-width: 22ch; line-height: 1.45;
  }
  .ph__hint { font-family: var(--font-hand); font-size: 1.15rem; line-height: 1; color: var(--blue); opacity: 0.85; }
  @container (max-width: 120px) { .ph__label, .ph__hint { display: none; } }
</style>
