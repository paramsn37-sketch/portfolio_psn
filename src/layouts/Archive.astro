---
import Base from './Base.astro';
import TopBar from '@/components/nav/TopBar.astro';
import NavPanel from '@/components/nav/NavPanel.astro';
interface Props { title?: string; description?: string; current?: string }
const { title, description, current = 'enter' } = Astro.props;
---
<Base title={title} description={description} bodyClass="paper-world" current={current}>
  <a class="skip-link" href="#main">Skip to content</a>
  <span id="top" tabindex="-1"></span>
  <TopBar current={current} />
  <div class="frame">
    <main id="main" tabindex="-1" class="frame__main">
      <slot />
    </main>
  </div>
  <slot name="after" />
  <NavPanel />
  <script>
    import '@/scripts/dialogs';
    import '@/scripts/nav';
    import '@/scripts/reveal';
  </script>
</Base>

<style>
  .frame {
    padding-top: var(--bar-h);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .frame__main { min-width: 0; outline: none; }
</style>
